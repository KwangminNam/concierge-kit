{
  "name": "@concierge-kit/h3",
  "version": "0.1.0",
  "description": "h3 and Nuxt adapter for concierge-kit. Relays cookies between the browser and your backend from a nitro server route.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "h3",
    "nuxt",
    "nitro",
    "bff",
    "cookie",
    "set-cookie",
    "relay"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@concierge-kit/core": "workspace:^"
  },
  "peerDependencies": {
    "h3": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "h3": "^1.15.11",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
