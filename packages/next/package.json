{
  "name": "@concierge-kit/next",
  "version": "0.1.0",
  "description": "Next.js App Router adapter for concierge-kit. Relays cookies between the browser and your backend from route handlers and server actions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "next",
    "app-router",
    "bff",
    "cookie",
    "set-cookie",
    "relay"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@concierge-kit/core": "workspace:^"
  },
  "peerDependencies": {
    "next": ">=15.0.0 <17",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "next": "15.5.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KwangminNam/concierge-kit.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/KwangminNam/concierge-kit#readme",
  "bugs": {
    "url": "https://github.com/KwangminNam/concierge-kit/issues"
  }
}
